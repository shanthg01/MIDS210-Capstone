# Local Docker (default)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/portalpoint

# Supabase (optional — replace DATABASE_URL for team-shared dev DB)
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/portalpoint

REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600        # set to 86400 in local dev to avoid hourly re-login
ENVIRONMENT=development

# AWS S3 — bronze data + model artifacts (set after bucket created)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=portalpoint-data

# MLflow — model tracking for notebooks (install: pip install -r notebooks/requirements-notebooks.txt)
MLFLOW_TRACKING_URI=sqlite:///mlruns.db      # local dev; mlflow ui --backend-store-uri mlruns.db
# MLFLOW_TRACKING_URI=s3://portalpoint-data/mlflow  # prod S3 backend
